# ── Application ───────────────────────────────────────────────────────────────
APP_NAME="OEI Nexus API"
APP_VERSION="1.0.0"
DEBUG=false
ENVIRONMENT=development   # development | staging | production
LOG_LEVEL=INFO            # DEBUG | INFO | WARNING | ERROR

# ── API ───────────────────────────────────────────────────────────────────────
API_V1_PREFIX=/api/v1
# REQUIRED in production — generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-long-random-secret-key-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7
ALGORITHM=HS256

# ── Database ──────────────────────────────────────────────────────────────────
# Async driver (FastAPI runtime)
DATABASE_URL=postgresql+asyncpg://oei:oei_password@db:5432/oei_nexus
# Sync driver (Alembic migrations only)
DATABASE_URL_SYNC=postgresql://oei:oei_password@db:5432/oei_nexus

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0

# ── CORS ──────────────────────────────────────────────────────────────────────
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# ── First superuser (seed) ────────────────────────────────────────────────────
FIRST_SUPERUSER_EMAIL=admin@oeinexus.org
FIRST_SUPERUSER_PASSWORD=changeme123   # MUST change in production

# ── Observability (optional) ──────────────────────────────────────────────────
# SENTRY_DSN=https://your-dsn@sentry.io/project-id

# ── Production concurrency ────────────────────────────────────────────────────
# WEB_CONCURRENCY=4   # Gunicorn worker count (default: 2*CPU+1)
# PORT=8000
